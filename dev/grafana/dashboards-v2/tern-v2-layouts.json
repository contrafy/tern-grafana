{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "tern-v2-layouts",
    "annotations": {
      "grafana.app/folder": "tern-fixtures"
    }
  },
  "spec": {
    "title": "Tern V2 Layouts",
    "description": "Schema v2 dashboard (tabs, auto grid, rows) that Grafana 13 serves through /api/dashboards/uid as v1.",
    "tags": ["fixtures", "tern", "v2"],
    "editable": true,
    "cursorSync": "Off",
    "liveNow": false,
    "preload": false,
    "links": [],
    "annotations": [],
    "timeSettings": {
      "from": "now-1h",
      "to": "now",
      "autoRefresh": "",
      "autoRefreshIntervals": ["30s", "1m", "5m"],
      "fiscalYearStartMonth": 0,
      "hideTimepicker": false,
      "timezone": "utc"
    },
    "variables": [
      {
        "kind": "CustomVariable",
        "spec": {
          "name": "job",
          "label": "Job",
          "query": "prometheus,node",
          "current": { "text": "prometheus", "value": "prometheus" },
          "options": [
            { "text": "prometheus", "value": "prometheus", "selected": true },
            { "text": "node", "value": "node", "selected": false }
          ],
          "multi": false,
          "includeAll": false,
          "hide": "dontHide",
          "skipUrlSync": false,
          "allowCustomValue": true
        }
      }
    ],
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Targets up",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": { "name": "prom3" },
                      "spec": { "expr": "sum(up{job=\"$job\"})" }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.3.0",
            "spec": {
              "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
              "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
            }
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Scrape duration",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": { "name": "prom3" },
                      "spec": { "expr": "scrape_duration_seconds{job=\"$job\"}", "legendFormat": "{{instance}}" }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "13.3.0",
            "spec": {
              "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } },
              "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
            }
          }
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Notes",
          "description": "",
          "links": [],
          "data": { "kind": "QueryGroup", "spec": { "queries": [], "transformations": [], "queryOptions": {} } },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "text",
            "version": "13.3.0",
            "spec": {
              "options": { "mode": "markdown", "content": "Second tab, first row." },
              "fieldConfig": { "defaults": {}, "overrides": [] }
            }
          }
        }
      },
      "panel-4": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "Samples appended",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": { "name": "prom3" },
                      "spec": { "expr": "rate(prometheus_tsdb_head_samples_appended_total[1m])" }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "13.3.0",
            "spec": { "options": {}, "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] } }
          }
        }
      }
    },
    "layout": {
      "kind": "TabsLayout",
      "spec": {
        "tabs": [
          {
            "kind": "TabsLayoutTab",
            "spec": {
              "title": "Overview",
              "layout": {
                "kind": "AutoGridLayout",
                "spec": {
                  "maxColumnCount": 3,
                  "columnWidthMode": "standard",
                  "rowHeightMode": "standard",
                  "fillScreen": false,
                  "items": [
                    { "kind": "AutoGridLayoutItem", "spec": { "element": { "kind": "ElementReference", "name": "panel-1" } } },
                    { "kind": "AutoGridLayoutItem", "spec": { "element": { "kind": "ElementReference", "name": "panel-2" } } }
                  ]
                }
              }
            }
          },
          {
            "kind": "TabsLayoutTab",
            "spec": {
              "title": "Details",
              "layout": {
                "kind": "RowsLayout",
                "spec": {
                  "rows": [
                    {
                      "kind": "RowsLayoutRow",
                      "spec": {
                        "title": "Notes",
                        "collapse": false,
                        "layout": {
                          "kind": "GridLayout",
                          "spec": {
                            "items": [
                              {
                                "kind": "GridLayoutItem",
                                "spec": { "x": 0, "y": 0, "width": 24, "height": 4, "element": { "kind": "ElementReference", "name": "panel-3" } }
                              }
                            ]
                          }
                        }
                      }
                    },
                    {
                      "kind": "RowsLayoutRow",
                      "spec": {
                        "title": "TSDB",
                        "collapse": true,
                        "layout": {
                          "kind": "GridLayout",
                          "spec": {
                            "items": [
                              {
                                "kind": "GridLayoutItem",
                                "spec": { "x": 0, "y": 0, "width": 12, "height": 8, "element": { "kind": "ElementReference", "name": "panel-4" } }
                              }
                            ]
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    }
  }
}
