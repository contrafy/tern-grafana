{
  "uid": "tern-pub-gauges",
  "title": "Tern Pub Gauges",
  "schemaVersion": 39,
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["tern"],
  "editable": false,
  "panels": [
    {
      "id": 1,
      "type": "bargauge",
      "title": "Pressure",
      "description": "Small horizontal bar gauge: names left of the bars (public 1860 Pressure).",
      "gridPos": { "x": 0, "y": 0, "w": 3, "h": 4 },
      "pluginVersion": "11.6.1",
      "datasource": { "type": "prometheus", "uid": "prom3" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 1,
          "min": 0,
          "max": 1,
          "unit": "percentunit",
          "thresholds": {
            "mode": "percentage",
            "steps": [
              { "color": "green", "value": null },
              { "color": "dark-yellow", "value": 70 },
              { "color": "dark-red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "namePlacement": "auto",
        "showUnfilled": true,
        "sizing": "auto",
        "minVizHeight": 10,
        "minVizWidth": 0,
        "maxVizHeight": 300,
        "valueMode": "color",
        "text": {},
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prom3" }, "expr": "vector(0.061)", "legendFormat": "CPU", "instant": true, "range": false, "editorMode": "code" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prom3" }, "expr": "vector(0.001)", "legendFormat": "Mem", "instant": true, "range": false, "editorMode": "code" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "prom3" }, "expr": "vector(0.014)", "legendFormat": "I/O", "instant": true, "range": false, "editorMode": "code" }
      ]
    },
    {
