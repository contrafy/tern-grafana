      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prom3" }, "expr": "vector(8589934592)", "instant": true, "range": false, "editorMode": "code" }
      ]
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "",
      "description": "Untitled lcd bar gauge: names above the bars (public 11074 CPU Busy).",
      "gridPos": { "x": 5, "y": 0, "w": 3, "h": 6 },
      "pluginVersion": "7.2.0",
      "datasource": { "type": "prometheus", "uid": "prom3" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 1,
          "min": 0.1,
          "max": 100,
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "#EAB839", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "lcd",
        "orientation": "horizontal",
        "showUnfilled": true,
        "reduceOptions": { "calcs": ["last"], "fields": "", "values": false }
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prom3" }, "expr": "vector(18.5)", "legendFormat": "CPU Busy", "instant": true, "range": false, "editorMode": "code" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prom3" }, "expr": "vector(64.5)", "legendFormat": "Used RAM Memory", "instant": true, "range": false, "editorMode": "code" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "prom3" }, "expr": "vector(2.5)", "legendFormat": "Used Max Mount(/etc/hostname)", "instant": true, "range": false, "editorMode": "code" },
        { "refId": "D", "datasource": { "type": "prometheus", "uid": "prom3" }, "expr": "vector(23.6)", "legendFormat": "Used SWAP", "instant": true, "range": false, "editorMode": "code" }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "HTTP Status Code",
      "description": "A 2-row stat without data (public Blackbox Exporter).",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 2 },
      "datasource": { "type": "prometheus", "uid": "prom3" },
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A",
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "text", "value": null }]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "textMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prom3" }, "expr": "up{job=\"tern-no-such-job\"}", "instant": true, "range": false, "editorMode": "code" }
      ]
    },
    {
      "id": 7,
      "type": "gauge",
      "title": "Memory Usage",
      "description": "A gauge saved with pluginVersion v13.0.0 and no options (public node-mixin): not migrated, so gauge/v2 defaults.",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 7 },
      "pluginVersion": "v13.0.0",
      "datasource": { "type": "prometheus", "uid": "prom3" },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "unit": "percent",
          "thresholds": {
            "steps": [
              { "color": "rgba(50, 172, 45, 0.97)" },
              { "color": "rgba(237, 129, 40, 0.89)", "value": 80 },
              { "color": "rgba(245, 54, 54, 0.9)", "value": 90 }
            ]
          }
        }
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prom3" }, "expr": "65 + 3 * sin(vector(time() / 600))", "editorMode": "code" }
      ]
    },
    {
      "id": 8,
      "type": "gauge",
      "title": "CPU Busy",
      "description": "A small gauge saved by Grafana 11.6 (migrated: no gradient, no sparkline).",
      "gridPos": { "x": 18, "y": 0, "w": 3, "h": 4 },
      "pluginVersion": "11.6.1",
      "datasource": { "type": "prometheus", "uid": "prom3" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 1,
          "min": 0,
          "max": 100,
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "dark-green", "value": null },
              { "color": "orange", "value": 85 },
              { "color": "red", "value": 95 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "minVizHeight": 75,
        "minVizWidth": 75,
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "sizing": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prom3" }, "expr": "vector(18.9)", "instant": true, "range": false, "editorMode": "code" }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Number of active alerts",
      "description": "A stat sparkline over a series with gaps: samples alone between gaps and one dense run (public Alertmanager 9578). Grafana draws only the run.",
      "gridPos": { "x": 0, "y": 7, "w": 3, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prom3" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "textMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prom3" }, "expr": "vector(4) and on() (vector(time() % 3600) >= 2700) or vector(3) and on() (vector(time() % 600) < 1)", "editorMode": "code" }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Panics",
      "description": "A 3-row stat with graphMode area (public Loki 17781): BigValue's box is too short for its chart.",
      "gridPos": { "x": 3, "y": 7, "w": 3, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "prom3" },
      "fieldConfig": {
        "defaults": {
