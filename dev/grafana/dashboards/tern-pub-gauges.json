      "type": "stat",
      "title": "CPU Cores",
      "gridPos": { "x": 3, "y": 2, "w": 2, "h": 2 },
      "pluginVersion": "7.2.0",
      "datasource": { "type": "prometheus", "uid": "prom3" },
