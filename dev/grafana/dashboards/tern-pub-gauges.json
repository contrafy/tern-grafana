        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prom3" }, "expr": "vector(10)", "instant": true, "range": false, "editorMode": "code" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Total RAM",
      "gridPos": { "x": 3, "y": 4, "w": 2, "h": 2 },
      "pluginVersion": "7.2.0",
      "datasource": { "type": "prometheus", "uid": "prom3" },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
