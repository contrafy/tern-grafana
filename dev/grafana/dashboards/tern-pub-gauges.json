      "type": "stat",
      "title": "Uptime",
      "gridPos": { "x": 3, "y": 0, "w": 2, "h": 2 },
      "pluginVersion": "7.2.0",
      "datasource": { "type": "prometheus", "uid": "prom3" },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "rgba(245, 54, 54, 0.9)", "value": null },
              { "color": "rgba(237, 129, 40, 0.89)", "value": 1 },
              { "color": "rgba(50, 172, 45, 0.97)", "value": 3 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "textMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prom3" }, "expr": "vector(82800)", "instant": true, "range": false, "editorMode": "code" }
      ]
    },
