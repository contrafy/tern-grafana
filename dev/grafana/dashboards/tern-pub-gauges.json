    {
      "id": 11,
      "type": "stat",
      "title": "Memory Chunks",
      "description": "A stat with a blue sparkline and no value color, as a migrated singlestat (public Prometheus 2.0 overview 3662): the chart fills the height the value leaves.",
      "gridPos": { "x": 6, "y": 7, "w": 6, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prom3" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": { "mode": "fixed", "fixedColor": "#3274D9" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "textMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prom3" }, "expr": "vector(48000 + 9000 * (time() % 1200 < bool 300))", "editorMode": "code" }
