{
  "uid": "tern-panels",
  "title": "Tern Panels",
  "tags": [
    "tern",
    "fixtures",
    "panels"
  ],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "graphTooltip": 1,
  "links": [],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "prom3"
        },
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "name": "Firing alerts",
        "expr": "ALERTS{alertstate=\"firing\"}",
        "step": "60s",
        "titleFormat": "{{alertname}}",
        "tagKeys": "severity",
        "useValueForTime": false
      }
    ]
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "CPU by mode",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom3"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 4
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom3"
          },
          "expr": "sum by (mode) (rate(node_cpu_seconds_total[$__rate_interval]))",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "legendFormat": "{{mode}}"
        }
      ],
      "description": "Multiple series; linked from the TernGrafanaAlwaysFiring alert rule."
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Memory (stacked)",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom3"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 4294967296
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 40,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom3"
          },
          "expr": "node_memory_MemFree_bytes",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "legendFormat": "free"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prom3"
          },
          "expr": "node_memory_Cached_bytes",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "legendFormat": "cached"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prom3"
          },
          "expr": "node_memory_Buffers_bytes",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "legendFormat": "buffers"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Prometheus HTTP request rate",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom3"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "showPoints": "auto",
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "/api/v1/query"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom3"
          },
          "expr": "sum by (handler) (rate(prometheus_http_requests_total[$__rate_interval])) > 0",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "legendFormat": "{{handler}}"
        }
      ]
    },
