{
  "uid": "tern-s4-json",
  "title": "Tern S4 JSON API",
  "description": "Gauges on marcusolsson-json-datasource: GET, empty urlPath, one JSONPath field; the datasource appends a fake appid from jsonData.queryParams.",
  "tags": [
    "tern",
    "s4"
  ],
  "editable": false,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "Dallas temperature",
      "datasource": {
        "type": "marcusolsson-json-datasource",
        "uid": "json-dallas"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "fahrenheit",
          "min": 0,
          "max": 120,
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "green",
                "value": 50
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "sizing": "auto",
        "minVizWidth": 75,
        "minVizHeight": 75
      },
      "targets": [
        {
          "datasource": {
            "type": "marcusolsson-json-datasource",
            "uid": "json-dallas"
          },
          "refId": "A",
          "method": "GET",
          "urlPath": "",
          "fields": [
            {
              "jsonPath": "$.main.temp"
            }
          ],
          "cacheDurationSeconds": 0
        }
      ]
    },
