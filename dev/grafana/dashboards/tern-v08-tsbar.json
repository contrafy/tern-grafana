    {
      "id": 2,
      "type": "barchart",
      "title": "Daily counts, newest row first (time x)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('day', now() AT TIME ZONE 'UTC') AT TIME ZONE 'UTC' - make_interval(days => n) AS day,\n  (n * 7) % 9 AS critical, CASE WHEN n % 11 = 1 THEN 1 END AS minor\nFROM generate_series(0, 59) AS n\nORDER BY 1 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisLabel": "# Incidents",
            "fillOpacity": 51,
            "lineWidth": 1,
