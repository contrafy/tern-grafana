            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('month', now() AT TIME ZONE 'UTC') AT TIME ZONE 'UTC' - make_interval(months => n) AS time,\n  (ARRAY[3.2, 6.2, 16.7, 8.33])[n + 1] * 3600 AS mean\nFROM generate_series(0, 3) AS n\nORDER BY 1"
        }
