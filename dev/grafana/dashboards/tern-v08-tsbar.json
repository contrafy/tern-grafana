      "timeFrom": "6h",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('minute', now()) - make_interval(mins => n * 13) AS time,\n  (n % 3 = 0)::int AS blank, (n % 4 = 1)::int AS email, (n % 5 = 2)::int + (n = 7)::int AS nrtc, 0 AS phone\nFROM generate_series(0, 26) AS n\nORDER BY 1"
        }
