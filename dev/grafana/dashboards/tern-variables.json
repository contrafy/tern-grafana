{
  "uid": "tern-variables",
  "title": "Tern Variables",
  "tags": [
    "tern",
    "fixtures",
    "variables"
  ],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {},
  "graphTooltip": 1,
  "links": [],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "ds",
        "label": "Datasource",
        "query": "prometheus",
        "regex": "",
        "refresh": 1,
        "hide": 0,
        "multi": false,
        "includeAll": false,
        "current": {
          "selected": true,
          "text": "Prometheus 3",
          "value": "prom3"
        },
        "options": []
      },
      {
        "type": "query",
        "name": "job",
        "label": "Job",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "query": {
          "query": "label_values(up, job)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "definition": "label_values(up, job)",
        "refresh": 1,
        "regex": "",
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "hide": 0,
        "current": {},
        "options": [],
        "allValue": ".*"
      },
      {
        "type": "query",
        "name": "instance",
        "label": "Instance",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "query": "label_values(up{job=~\"$job\"}, instance)",
        "definition": "label_values(up{job=~\"$job\"}, instance)",
        "refresh": 1,
        "regex": "",
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "hide": 0,
        "current": {},
        "options": [],
        "allValue": ".*"
      },
      {
        "type": "query",
        "name": "metric",
        "label": "Metric",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "query": "metrics(node_memory_.*_bytes)",
        "definition": "metrics(node_memory_.*_bytes)",
        "refresh": 2,
        "regex": "/node_memory_(Mem|Cached|Buffers).*/",
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "hide": 0,
        "current": {},
        "options": []
      },
      {
        "type": "query",
        "name": "topjob",
        "label": "Top job",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "query": "query_result(topk(3, sum by (job) (up)))",
        "definition": "query_result(topk(3, sum by (job) (up)))",
        "refresh": 1,
        "regex": "/job=\"([^\"]+)\"/",
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "hide": 0,
        "current": {},
        "options": []
      },
      {
        "type": "custom",
        "name": "mode",
        "label": "CPU mode",
        "query": "user,system,idle,iowait",
        "multi": true,
        "includeAll": true,
        "allValue": "user|system|idle|iowait",
        "hide": 0,
        "current": {
          "selected": true,
          "text": [
            "user",
            "system"
          ],
          "value": [
            "user",
            "system"
          ]
        },
        "options": [
          {
            "selected": true,
            "text": "user",
            "value": "user"
          },
          {
            "selected": true,
            "text": "system",
            "value": "system"
          },
          {
            "selected": false,
            "text": "idle",
            "value": "idle"
          },
          {
            "selected": false,
            "text": "iowait",
            "value": "iowait"
          }
        ]
      },
      {
        "type": "constant",
        "name": "env",
        "label": "Environment",
        "query": "dev",
        "hide": 2,
        "current": {
          "text": "dev",
          "value": "dev"
        },
        "options": [
          {
            "selected": true,
            "text": "dev",
            "value": "dev"
          }
        ]
      },
      {
        "type": "interval",
        "name": "step",
        "label": "Step",
        "query": "10s,30s,1m,5m,10m",
        "auto": true,
        "auto_count": 30,
        "auto_min": "10s",
        "refresh": 2,
        "hide": 0,
        "current": {
          "selected": true,
          "text": "1m",
          "value": "1m"
        },
        "options": [
          {
            "selected": false,
            "text": "10s",
            "value": "10s"
          },
          {
            "selected": false,
            "text": "30s",
            "value": "30s"
          },
          {
            "selected": true,
            "text": "1m",
            "value": "1m"
          },
          {
            "selected": false,
            "text": "5m",
            "value": "5m"
          },
          {
            "selected": false,
            "text": "10m",
            "value": "10m"
          }
        ]
      },
      {
        "type": "textbox",
        "name": "handler",
        "label": "Handler filter",
        "query": "/api/v1/.*",
        "hide": 0,
        "current": {
          "text": "/api/v1/.*",
          "value": "/api/v1/.*"
        },
        "options": [
          {
            "selected": true,
            "text": "/api/v1/.*",
            "value": "/api/v1/.*"
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU $mode on $instance",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom3"
          },
          "expr": "sum by (mode) (rate(node_cpu_seconds_total{mode=~\"$mode\", instance=~\"$instance\"}[$step]))",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "legendFormat": "{{mode}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests matching $handler",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom3"
          },
          "expr": "sum by (handler) (rate(prometheus_http_requests_total{handler=~\"$handler\"}[$__rate_interval]))",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "legendFormat": "{{handler}}",
          "interval": "$step"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "up for $job",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom3"
          },
          "expr": "sum(up{job=~\"$job\", env=~\"$env|\"})",
          "range": false,
          "instant": true,
          "editorMode": "code"
        }
      ],
      "repeat": "job",
      "repeatDirection": "h",
      "maxPerRow": 4
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "$metric",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom3"
          },
          "expr": "$metric",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "row",
      "title": "Instance $instance",
      "collapsed": false,
      "repeat": "instance",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Scrape duration $instance",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom3"
          },
          "expr": "scrape_duration_seconds{instance=~\"$instance\"}",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "legendFormat": "{{job}}"
        }
      ]
    }
  ]
}
