{
  "uid": "tern-pub-grid",
  "title": "Tern Pub Grid",
  "tags": [
    "tern"
  ],
  "schemaVersion": 39,
  "editable": false,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "type": "link",
      "title": "Docs",
      "tooltip": "Prometheus documentation",
      "url": "https://prometheus.io/docs/",
      "icon": "doc",
      "targetBlank": true,
      "tags": []
    },
    {
      "type": "link",
      "title": "Explore $integration",
      "url": "/explore?orgId=1",
      "icon": "bolt",
      "keepTime": true,
      "includeVars": true,
      "tags": []
    },
    {
      "type": "dashboards",
      "title": "Tern",
      "tags": [
        "tern"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link"
    }
  ],
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "ds",
        "label": "Data Source",
        "query": "prometheus",
        "regex": "",
        "refresh": 1,
        "hide": 0,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "Prometheus 3",
          "value": "prom3"
        },
        "options": []
      },
      {
        "type": "custom",
        "name": "integration",
        "label": "integration",
        "query": "email,pagerduty,slack,webhook,wechat,webex",
        "hide": 0,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Resource Details",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Uptime",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 2,
        "h": 2
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "vector(1)",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "",
      "gridPos": {
        "x": 2,
        "y": 1,
        "w": 3,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "vector(0.5)",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Disk Space Used",
      "gridPos": {
        "x": 5,
        "y": 1,
        "w": 10,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "up",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "CPU iowait",
      "gridPos": {
        "x": 15,
        "y": 1,
        "w": 2,
        "h": 2
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "vector(2)",
          "instant": true
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Internet traffic per hour",
      "gridPos": {
        "x": 17,
        "y": 1,
        "w": 7,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "vector(3)",
          "instant": false
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "CPU Cores",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 2,
        "h": 2
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "vector(4)",
          "instant": true
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Free inodes",
      "gridPos": {
        "x": 15,
        "y": 3,
        "w": 2,
        "h": 2
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "vector(5)",
          "instant": true
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Total RAM",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 2,
        "h": 2
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "vector(6)",
          "instant": true
        }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Total filefd",
      "gridPos": {
        "x": 15,
        "y": 5,
        "w": 2,
        "h": 2
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "vector(7)",
          "instant": true
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "$integration: Send Rate",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "vector(1)",
          "instant": false
        }
      ],
      "repeat": "integration",
      "repeatDirection": "h",
      "maxPerRow": 4
    }
  ]
}
