auge","unit":"","help":"Number of bytes used for garbage collection system metadata."},{"type":"gauge","unit":"","help":"Number of bytes used for garbage collection system metadata. Equals to /memory/classes/metadata/other:bytes."}],"go_sched_pauses_total_gc_seconds":[{"type":"histogram","unit":"","help":"Distribution of individual GC-related stop-the-world pause latencies. This is the time from deciding to stop the world until the world is started again. Some of this time is spent getting all threads to stop (this is measured directly in /sched/pauses/stopping/gc:seconds), during which some threads may still be running. Bucket counts increase monotonically."},{"type":"histogram","unit":"","help":"Distribution of individual GC-related stop-the-world pause latencies. This is the time from deciding to stop the world until the world is started again. Some of this time is spent getting all threads to stop (this is measured directly in /sched/pauses/stopping/gc:seconds), during which some threads may still be running. Bucket counts increase monotonically. Sourced from /sched/pauses/total/gc:seconds."}],"grpc_concurrent_streams_by_conn_max":[{"type":"gauge","unit":"","help":"The current number of concurrent streams in the connection with the most concurrent streams."}],"loki_ingester_chunk_compression_ratio":[{"type":"histogram","unit":"","help":"Compression ratio of chunks (when stored)."}],"loki_query_frontend_sharding_parsed_queries":[{"type":"counter","unit":"","help":"Number of parsed queries by evaluation type"}],"loki_response_message_bytes":[{"type":"histogram","unit":"","help":"Size (in bytes) of messages sent in response."}],"loki_ring_member_heartbeats":[{"type":"counter","unit":"","help":"The total number of heartbeats sent."}],"loki_store_chunk_ref_lookups_bypassed":[{"type":"counter","unit":"","help":"Number of chunk refs that were bypassed due to store overrides: computed during planning to avoid lookups"}],"loki_tsdb_head_rotation_attempts":[{"type":"count