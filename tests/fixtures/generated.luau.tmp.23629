enders natively.\n\n- timeseries: multi-series, stacking, thresholds, units\n- stat, gauge, bargauge, table\n- logs, heatmap, state-timeline\n- rows (open and collapsed), a library panel\n\nSee [the dev stack docs](https://github.com/contrafy/tern-grafana/blob/master/docs/dev-stack.md).","mode":"markdown"},"title":"About these fixtures","type":"text"},{"collapsed":false,"gridPos":{"h":1,"w":24,"x":0,"y":25},"id":11,"panels":[],"title":"Logs and distributions","type":"row"},{"datasource":{"type":"loki","uid":"loki"},"fieldConfig":{"defaults":{},"overrides":[]},"gridPos":{"h":10,"w":12,"x":0,"y":26},"id":12,"options":{"dedupStrategy":"none","enableLogDetails":true,"prettifyLogMessage":false,"showCommonLabels":false,"showLabels":false,"showTime":true,"sortOrder":"Descending","wrapLogMessage":true},"targets":[{"datasource":{"type":"loki","uid":"loki"},"editorMode":"code","expr":"{job=\"loggen\"} != \"debug\"","queryType":"range","refId":"A"}],"title":"Generated logs","type":"logs"},{"datasource":{"type":"prometheus","uid":"prom3"},"fieldConfig":{"defaults":{},"overrides":[]},"gridPos":{"h":10,"w":12,"x":12,"y":26},"id":13,"options":{"calculate":false,"cellGap":1,"color":{"exponent":0.5,"fill":"dark-orange","mode":"scheme","scheme":"Oranges","steps":64},"legend":{"show":true},"rowsFrame":{"layout":"auto"},"tooltip":{"mode":"single","yHistogram":false},"yAxis":{"axisPlacement":"left","unit":"s"}},"targets":[{"datasource":{"type":"prometheus","uid":"prom3"},"editorMode":"code","expr":"sum by (le) (increase(traces_spanmetrics_latency_bucket[$__rate_interval]))","format":"heatmap","instant":false,"legendFormat":"{{le}}","range":true,"refId":"A"}],"title":"Span latency heatmap","type":"heatmap"},{"datasource":{"type":"prometheus","uid":"prom3"},"fieldConfig":{"defaults":{"color":{"mode":"thresholds"},"custom":{"fillOpacity":70,"lineWidth":0},"mappings":[{"options":{"0":{"color":"red","index":0,"text":"Down"},"1":{"color":"green","index":1,"text":"Up"}},"type":"value"}],"thres