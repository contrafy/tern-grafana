{"status":"success","data":{"alertmanager_dispatcher_alert_processing_duration_seconds":[{"type":"summary","unit":"","help":"Summary of latencies for the processing of alerts."}],"alertmanager_nflog_queries_total":[{"type":"counter","unit":"","help":"Number of notification log queries were received."}],"go_cpu_classes_idle_cpu_seconds":[{"type":"counter","unit":"","help":"Estimated total available CPU time not spent executing any Go or Go runtime code. In other words, the part of /cpu/classes/total:cpu-seconds that was unused. This metric is an overestimate, and not directly comparable to system CPU time measurements. Compare only with other /cpu/classes metrics. Sourced from /cpu/classes/idle:cpu-seconds."}],"go_cpu_classes_scavenge_assist_cpu_seconds":[{"type":"counter","unit":"","help":"Estimated total CPU time spent returning unused memory to the underlying platform in response eagerly to memory pressure. This metric is an overestimate, and not directly comparable to system CPU time measurements. Compare only with other /cpu/classes metrics. Sourced from /cpu/classes/scavenge/assist:cpu-seconds."}],"go_gc_pauses_seconds":[{"type":"histogram","unit":"","help":"Deprecated. Prefer the identical /sched/pauses/total/gc:seconds. Sourced from /gc/pauses:seconds."}],"go_godebug_non_default_behavior_http2server_events":[{"type":"counter","unit":"","help":"The number of non-default behaviors executed by the net/http package due to a non-default GODEBUG=http2server=... setting. Sourced from /godebug/non-default-behavior/http2server:events."}],"go_godebug_non_default_behavior_multipartmaxheaders_events":[{"type":"counter","unit":"","help":"The number of non-default behaviors executed by the mime/multipart package due to a non-default GODEBUG=multipartmaxheaders=... setting. Sourced from /godebug/non-default-behavior/multipartmaxheaders:events."}],"go_godebug_non_default_behavior_x509usepolicies_events":[{"type":"counter","unit":"","help":"The number of non-default behaviors executed by the crypto/x509 package due to a non-default GODEBUG=x509usepolicies=... setting. Sourced from /godebug/non-default-behavior/x509usepolicies:events."}],"go_memstats_mallocs_total":[{"type":"counter","unit":"","help":"Total number of heap objects allocated, both live and gc-ed. Semantically a counter version for go_memstats_heap_objects gauge. Equals to /gc/heap/allocs:objects + /gc/heap/tiny/allocs:objects."}],"go_memstats_stack_sys_bytes":[{"type":"gauge","unit":"","help":"Number of bytes obtained from system for stack allocator. Equals to /memory/classes/heap/stacks:bytes + /memory/classes/os-stacks:bytes."}],"go_sched_latencies_seconds":[{"type":"histogram","unit":"","help":"Distribution of the time goroutines have spent in the scheduler in a runnable state before actually running. Bucket counts increase monotonically. Sourced from /sched/latencies:seconds."}],"go_sched_pauses_total_gc_seconds":[{"type":"histogram","unit":"","help":"Distribution of individual GC-related stop-the-world pause latencies. This is the time from deciding to stop the world until the world is started again. Some of this time is spent getting all threads to stop (this is measured directly in /sched/pauses/stopping/gc:seconds), during which some threads may still be running. Bucket counts increase monotonically. Sourced from /sched/pauses/total/gc:seconds."}],"loki_ingester_checkpoint_deletions_failed":[{"type":"counter","unit":"","help":"Total number of checkpoint deletions that failed."}],"loki_metastore_estimate_sections_sections_total":[{"type":"histogram","unit":"","help":"Total number of sections resolved for a Metastore query when listing sections from AMQ filters"}],"loki_metastore_estimate_sections_total_duration_seconds":[{"type":"histogram","unit":"","help":"Total time taken to check section membership for a Metastore query when listing sections from AMQ filters in seconds"}],"loki_querier_tail_bytes":[{"type":"counter","unit":"","help":"total bytes tailed"}],"loki_query_scheduler_connected_frontend_clients":[{"type":"gauge","unit":"","help":"Number of query-frontend worker clients currently connected to the query-scheduler."}],"net_conntrack_dialer_conn_established":[{"type":"counter","unit":"","help":"Total number of connections successfully established by the given dialer a given name."}],"node_disk_discard_time_seconds_total":[{"type":"counter","unit":"","help":"This is the total number of seconds spent by all discards."}],"node_disk_io_time_seconds_total":[{"type":"counter","unit":"","help":"Total seconds spent doing I/Os."}],"node_disk_io_time_weighted_seconds_total":[{"type":"counter","unit":"","help":"The weighted # of seconds spent doing I/Os."}],"node_netstat_TcpExt_SyncookiesRecv":[{"type":"unknown","unit":"","help":"Statistic TcpExtSyncookiesRecv."}],"node_network_carrier_down_changes_total":[{"type":"counter","unit":"","help":"Network device property: carrier_down_changes_total"}],"node_network_receive_multicast_total":[{"type":"counter","unit":"","help":"Network device statistic receive_multicast."}],"node_nf_conntrack_stat_early_drop":[{"type":"gauge","unit":"","help":"Number of dropped conntrack entries to make room for new ones, if maximum table size was reached."}],"node_nfs_rpc_authentication_refreshes_total":[{"type":"counter","unit":"","help":"Number of RPC authentication refreshes performed."}],"node_nfsd_server_rpcs_total":[{"type":"counter","unit":"","help":"Total number of NFSd RPCs."}],"node_pressure_memory_waiting_seconds_total":[{"type":"counter","unit":"","help":"Total time in seconds that processes have waited for memory"}],"prometheus_agent_checkpoint_creations_failed":[{"type":"counter","unit":"","help":"Total number of checkpoint creations that failed."}],"prometheus_notifications_latency_histogram_seconds":[{"type":"histogram","unit":"","help":"Latency histogram for sending alert notifications."}],"prometheus_remote_storage_samples_pending":[{"type":"gauge","unit":"","help":"The number of samples pending in the queues shards to be sent to the remote storage."}],"prometheus_tsdb_compactions_failed_total":[{"type":"counter","unit":"","help":"Total number of compactions that failed for the partition."}],"prometheus_tsdb_isolation_high_watermark":[{"type":"gauge","unit":"","help":"The highest TSDB append ID that has been given out."}],"prometheus_tsdb_wal_corruptions_total":[{"type":"counter","unit":"","help":"Total number of WAL corruptions."}],"prometheus_tsdb_wal_writes_failed_total":[{"type":"counter","unit":"","help":"Total number of write log writes that failed."}],"tempo_distributor_bytes_received":[{"type":"counter","unit":"","help":"The total number of proto bytes received per tenant, after limits"}],"tempo_distributor_ingester_appends":[{"type":"counter","unit":"","help":"The total number of batch appends sent to ingesters."}],"tempo_distributor_metrics_generator_clients":[{"type":"gauge","unit":"","help":"The current number of metrics-generator clients."}],"tempo_ingester_live_trace_bytes":[{"type":"gauge","unit":"","help":"The current number of bytes consumed by lives traces per tenant."}],"tempo_metrics_generator_registry_series_limited":[{"type":"counter","unit":"","help":"The total amount of series not created because of limits per tenant"}]}}]=],
