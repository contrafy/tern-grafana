cises every panel type the **tern-grafana** plugin renders natively.\n\n- timeseries: multi-series, stacking, thresholds, units\n- stat, gauge, bargauge, table\n- logs, heatmap, state-timeline\n- rows (open and collapsed), a library panel\n\nSee [the dev stack docs](https://github.com/contrafy/tern-grafana/blob/master/docs/dev-stack.md).","mode":"markdown"},"title":"About these fixtures","type":"text"},{"collapsed":false,"gridPos":{"h":1,"w":24,"x":0,"y":25},"id":11,"panels":[],"title":"Logs and distributions","type":"row"},{"datasource":{"type":"loki","uid":"loki"},"fieldConfig":{"defaults":{},"overrides":[]},"gridPos":{"h":10,"w":12,"x":0,"y":26},"id":12,"options":{"dedupStrategy":"none","enableLogDetails":true,"prettifyLogMessage":false,"showCommonLabels":false,"showLabels":false,"showTime":true,"sortOrder":"Descending","wrapLogMessage":true},"targets":[{"datasource":{"type":"loki","uid":"loki"},"editorMode":"code","expr":"{job=\"loggen\"} != \"debug\"","queryType":"range","refId":"A"}],"title":"Generated logs","type":"logs"},{"datasource":{"type":"prometheus","uid":"prom3"},"fieldConfig":{"defaults":{},"overrides":[]},"gridPos":{"h":10,"w":12,"x":12,"y":26},"id":13,"options":{"calculate":false,"cellGap":1,"color":{"exponent":0.5,"fill":"dark-orange","mode":"scheme","scheme":"Oranges","steps":64},"legend":{"show":true},"rowsFrame":{"layout":"auto"},"tooltip":{"mode":"single","yHistogram":false},"yAxis":{"axisPlacement":"left","unit":"s"}},"targets":[{"datasource":{"type":"prometheus","uid":"prom3"},"editorMode":"code","expr":"sum by (le) (increase(traces_spanmetrics_latency_bucket[$__rate_interval]))","format":"heatmap","instant":false,"legendFormat":"{{le}}","range":true,"refId":"A"}],"title":"Span latency heatmap","type":"heatmap"},{"datasource":{"type":"prometheus","uid":"prom3"},"fieldConfig":{"defaults":{"color":{"mode":"thresholds"},"custom":{"fillOpacity":70,"lineWidth":0},"mappings":[{"options":{"0":{"color":"red","index":0,"text":"Down"},"1":{"color":"green","index":1,"text":"Up"}},"type":"value"}],"thresholds":{"mode":"absolute","steps":[{"color":"red","value":null},{"color":"green","value":1}]}},"overrides":[]},"gridPos":{"h":7,"w":24,"x":0,"y":36},"id":14,"options":{"alignValue":"left","legend":{"displayMode":"list","placement":"bottom","showLegend":true},"mergeValues":true,"rowHeight":0.9,"showValue":"auto"},"targets":[{"datasource":{"type":"prometheus","uid":"prom3"},"editorMode":"code","expr":"up","instant":false,"legendFormat":"{{job}} {{instance}}","range":true,"refId":"A"}],"title":"Target health","type":"state-timeline"},{"collapsed":true,"gridPos":{"h":1,"w":24,"x":0,"y":43},"id":15,"panels":[{"datasource":{"type":"prometheus","uid":"prom3"},"fieldConfig":{"defaults":{"unit":"short"},"overrides":[]},"gridPos":{"h":7,"w":12,"x":0,"y":44},"id":16,"options":{"legend":{"calcs":["lastNotNull","max"],"displayMode":"table","placement":"bottom","showLegend":true},"tooltip":{"mode":"multi","sort":"desc"}},"targets":[{"datasource":{"type":"prometheus","uid":"prom3"},"editorMode":"code","expr":"prometheus_tsdb_head_series","instant":false,"legendFormat":"{{job}}","range":true,"refId":"A"}],"title":"TSDB head series","type":"timeseries"},{"datasource":{"type":"prometheus","uid":"prom3"},"fieldConfig":{"defaults":{},"overrides":[]},"gridPos":{"h":7,"w":12,"x":12,"y":44},"id":17,"options":{"colorMode":"none","graphMode":"none","reduceOptions":{"calcs":["lastNotNull"],"fields":"","values":false}},"targets":[{"datasource":{"type":"prometheus","uid":"prom3"},"editorMode":"code","expr":"sum(prometheus_rule_group_rules)","instant":true,"range":false,"refId":"A"}],"title":"Loaded rule groups","type":"stat"}],"title":"Collapsed details","type":"row"},{"gridPos":{"h":8,"w":12,"x":0,"y":44},"id":18,"libraryPanel":{"name":"Tern library: up by job","uid":"tern-lib-up"}}],"refresh":"30s","schemaVersion":39,"tags":["tern","fixtures","panels"],"templating":{"list":[]},"time":{"from":"now-1h","to":"now"},"timepicker":{},"timezone":"