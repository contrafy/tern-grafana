--!strict
-- Expected values were produced by running Grafana's own formatters
-- (packages/grafana-data/src/valueFormats: baseFormatters.ts, symbolFormatters.ts,
-- arithmeticFormatters.ts, dateTimeFormatters.ts, categories.ts) on the same
-- inputs, so a panel reads the same in Tern as it does in Grafana.
local t = require("../../lib/test")
local format = require("../../../plugin/lib/units/format")
local describe, it, expect = t.describe, t.it, t.expect

local function check(unit: string?, value: number?, decimals: number?, prefix: string, text: string, suffix: string)
	expect(format.format(value, unit, decimals)).toEqual({ prefix = prefix, text = text, suffix = suffix })
end

describe("format.toFixed (baseFormatters.ts toFixed/getDecimalsForValue)", function()
	-- Auto decimals keep three significant digits on non-integers and none on
	-- integers, so 1.5 and 1.50 K line up across a legend.
	it("picks Grafana's automatic decimals", function()
		expect(format.toFixed(0)).toBe("0")
		expect(format.toFixed(1)).toBe("1")
		expect(format.toFixed(1.5)).toBe("1.50")
		expect(format.toFixed(0.123456)).toBe("0.123")
		expect(format.toFixed(12.3456)).toBe("12.3")
		expect(format.toFixed(123.456)).toBe("123")
		expect(format.toFixed(1234.5)).toBe("1235")
		expect(format.toFixed(-0.001234)).toBe("-0.00123")
	end)

	-- Math.round sends halves toward +Inf, so -0.125 rounds to -0.12, not -0.13.
	it("rounds halves the way JavaScript Math.round does", function()
		expect(format.toFixed(0.125, 2)).toBe("0.13")
		expect(format.toFixed(-0.125, 2)).toBe("-0.12")
		expect(format.toFixed(2.675, 2)).toBe("2.68")
		expect(format.toFixed(3.14159, 0)).toBe("3")
	end)

	it("pads explicit decimals and never prints negative zero", function()
		expect(format.toFixed(0, 2)).toBe("0.00")
		expect(format.toFixed(1, 3)).toBe("1.000")
		expect(format.toFixed(-0.0001, 2)).toBe("0.00")
	end)

	it("clamps negative decimals to zero", function()
		expect(format.toFixed(3.14159, -1)).toBe("3")
	end)

	it("keeps JavaScript's exponent form for tiny and huge values", function()
		expect(format.toFixed(1e-7)).toBe("1e-7")
		expect(format.toFixed(1e21)).toBe("1e+21")
	end)
end)

describe("format.format special values", function()
	it("renders nil as empty text (Grafana's null)", function()
		check("bytes", nil, nil, "", "", "")
	end)

	-- Prometheus returns NaN and +/-Inf samples; they must not pick up a scaled
	-- unit such as "∞ years".
	it("renders NaN and infinities without a unit", function()
		check("s", 0 / 0, nil, "", "NaN", "")
		check("ms", math.huge, nil, "", "∞", "")
		check("bytes", -math.huge, nil, "", "-∞", "")
		check("currencyUSD", math.huge, nil, "", "∞", "")
	end)

	it("treats a missing or empty unit as none", function()
		check(nil, 999.5, nil, "", "1000", "")
		check("", -42, nil, "", "-42", "")
		check("none", -42, nil, "", "-42", "")
	end)

	-- getValueFormat falls back to the id itself as a suffix, so custom unit
	-- strings typed into a dashboard still show.
	it("uses unknown ids, prefix: and suffix: as literal units", function()
		check("suffix:rpm", 12, nil, "", "12", " rpm")
		check("prefix:€", 12.5, nil, "€", "12.5", "")
		check("widgets", 3, nil, "", "3", " widgets")
	end)

	it("joins prefix, text and suffix", function()
		expect(format.text(-1500, "currencyUSD")).toBe("-$1.50K")
		expect(format.text(1536, "bytes")).toBe("1.50 KiB")
		expect(format.join({ prefix = "", text = "5", suffix = " ops/s" })).toBe("5 ops/s")
	end)
end)

describe("format.format short", function()
	it("switches suffix exactly at each power of 1000", function()
		check("short", 999, nil, "", "999", "")
		check("short", 1000, nil, "", "1", " K")
		check("short", 1500, nil, "", "1.50", " K")
		check("short", 999999, nil, "", "1000", " K")
		check("short", 1000000, nil, "", "1", " Mil")
		check("short", 1e9, nil, "", "1", " Bil")
		check("short", 2.5e12, nil, "", "2.50", " Tri")
	end)

	it("scales negatives by magnitude and stops at the last suffix", function()
		check("short", -1500, nil, "", "-1.50", " K")
		check("short", 0.5, nil, "", "0.500", "")
		check("short", 1e30, nil, "", "1000000", " Sept")
	end)
end)

describe("format.format percent", function()
	it("formats percent and percentunit (0-1 scaled by 100)", function()
		check("percent", 42, nil, "", "42", "%")
		check("percent", 99.95, 1, "", "100.0", "%")
		check("percentunit", 0.5, nil, "", "50", "%")
		check("percentunit", 0.1234, nil, "", "12.3", "%")
		check("percentunit", -0.25, nil, "", "-25", "%")
	end)
end)

describe("format.format data sizes", function()
	-- IEC units step at 1024, so 1000 B is still bytes; SI units step at 1000.
	it("steps bytes (IEC) at 1024, not 1000", function()
		check("bytes", 0, nil, "", "0", " B")
		check("bytes", 999, nil, "", "999", " B")
		check("bytes", 1000, nil, "", "1000", " B")
		check("bytes", 1023, nil, "", "1023", " B")
		check("bytes", 1024, nil, "", "1", " KiB")
		check("bytes", 1536, nil, "", "1.50", " KiB")
		check("bytes", 1048576, nil, "", "1", " MiB")
		check("bytes", -2048, nil, "", "-2", " KiB")
		check("bytes", 0.5, nil, "", "0.500", " B")
	end)

	it("steps decbytes (SI) at 1000, including milli below 1", function()
		check("decbytes", 999, nil, "", "999", " B")
		check("decbytes", 1000, nil, "", "1", " kB")
		check("decbytes", 1024, nil, "", "1.02", " kB")
		check("decbytes", 1500000, nil, "", "1.50", " MB")
		check("decbytes", 0.5, nil, "", "500", " mB")
		check("decbytes", -1000, nil, "", "-1", " kB")
	end)

	it("formats bits and decbits", function()
		check("bits", 1000, nil, "", "1000", " b")
		check("bits", 1024, nil, "", "1", " Kib")
		check("decbits", 999, nil, "", "999", " b")
		check("decbits", 1000, nil, "", "1", " kb")
	end)

	it("formats throughput units", function()
		check("bps", 999, nil, "", "999", " b/s")
		check("bps", 1000, nil, "", "1", " kb/s")
		check("bps", 1e9, nil, "", "1", " Gb/s")
		check("Bps", 1000, nil, "", "1", " kB/s")
		check("Bps", 1024, nil, "", "1.02", " kB/s")
		check("binBps", 1000, nil, "", "1000", " B/s")
		check("binBps", 1024, nil, "", "1", " KiB/s")
	end)
end)

describe("format.format time units", function()
	it("scales ns and µs up to larger units at each boundary", function()
		check("ns", 999, nil, "", "999", " ns")
		check("ns", 1000, nil, "", "1", " µs")
		check("ns", 1500000, nil, "", "1.50", " ms")
		check("ns", 6e10, nil, "", "1", " min")
		check("ns", -2000, nil, "", "-2", " µs")
		check("µs", 999, nil, "", "999", " µs")
		check("µs", 1000, nil, "", "1", " ms")
		check("µs", 1e6, nil, "", "1", " s")
	end)

	it("accepts us as an alias of µs", function()
		check("us", 1000, nil, "", "1", " ms")
	end)

	-- Plural suffixes depend on the scaled value: 1 min but 1.50 mins.
	it("scales ms with pluralized minute/hour/day/year suffixes", function()
		check("ms", 999, nil, "", "999", " ms")
		check("ms", 1000, nil, "", "1", " s")
		check("ms", 59999, nil, "", "60.0", " s")
		check("ms", 60000, nil, "", "1", " min")
		check("ms", 90000, nil, "", "1.50", " mins")
		check("ms", 3600000, nil, "", "1", " hour")
		check("ms", 86400000, nil, "", "1", " day")
		check("ms", 31536000000, nil, "", "1", " year")
		check("ms", -1500, nil, "", "-1.50", " s")
	end)

	it("scales seconds down to ns and up to years", function()
		check("s", 0, nil, "", "0", " s")
		check("s", 0.0000005, nil, "", "500", " ns")
		check("s", 0.0005, nil, "", "500", " µs")
		check("s", 0.5, nil, "", "500", " ms")
		check("s", 59, nil, "", "59", " s")
		check("s", 60, nil, "", "1", " min")
		check("s", 61, nil, "", "1.02", " mins")
		check("s", 3600, nil, "", "1", " hour")
		check("s", 5400, nil, "", "1.50", " hours")
		check("s", 86400, nil, "", "1", " day")
		check("s", 604800, nil, "", "1", " week")
		-- Grafana divides years by 3.15569e7 (a sidereal-ish year), not 365 days.
		check("s", 31536000, nil, "", "0.999", " year")
		check("s", -90, nil, "", "-1.50", " mins")
	end)

	it("scales minutes, hours and days", function()
		check("m", 59, nil, "", "59", " min")
		check("m", 60, nil, "", "1", " hour")
		check("m", 1440, nil, "", "1", " day")
		check("m", 10080, nil, "", "1", " week")
		check("m", 604800, nil, "", "1.15", " years")
		check("h", 23, nil, "", "23", " hour")
		check("h", 24, nil, "", "1", " day")
		check("h", 168, nil, "", "1", " week")
		check("h", 8760, nil, "", "1", " year")
		check("d", 1, nil, "", "1", " day")
		check("d", 6, nil, "", "6", " days")
		check("d", 7, nil, "", "1", " week")
		check("d", 365, nil, "", "1", " year")
		check("d", -3, nil, "", "-3", " days")
	end)

	-- decimals means "this many more units after the first", not fraction digits.
	it("spells out dtdurations with decimals as extra units", function()
		check("dtdurations", 0, nil, "", "0", " seconds")
		check("dtdurations", 1, nil, "", "1 second", "")
		check("dtdurations", 3661, nil, "", "1 hour", "")
		check("dtdurations", 3661, 2, "", "1 hour, 1 minute, 1 second", "")
		check("dtdurations", -60, nil, "", "1 minute", " ago")
		check("dtdurationms", 1500, 1, "", "1 second, 500 milliseconds", "")
	end)

	it("formats dthms and dtdhms clocks, marking negatives as ago", function()
		check("dthms", 3661, nil, "", "01:01:01", "")
		check("dthms", -59, nil, "", "00:00:59", " ago")
		check("dtdhms", 0, nil, "", "00:00:00", "")
		check("dtdhms", 86399, nil, "", "23:59:59", "")
		check("dtdhms", 90061, nil, "", "1 d 01:01:01", "")
		check("dtdhms", -90061, nil, "", "1 d 01:01:01", " ago")
	end)
end)

describe("format.format rates, frequency, temperature, currency", function()
	-- Count units glue the scale letter to the unit: "1.50K req/s".
	it("scales request and operation rates", function()
		check("reqps", 999, nil, "", "999", " req/s")
		check("reqps", 1000, nil, "", "1", "K req/s")
		check("reqps", 1500, nil, "", "1.50", "K req/s")
		check("reqps", -2500000, nil, "", "-2.50", "M req/s")
		check("rps", 1000, nil, "", "1", "K rd/s")
		check("ops", 5, nil, "", "5", " ops/s")
		check("wps", 1e6, nil, "", "1", "M wr/s")
		check("rpm", 42, nil, "", "42", " rd/m")
	end)

	it("formats hertz with SI prefixes", function()
		check("hertz", 999, nil, "", "999", " Hz")
		check("hertz", 1000, nil, "", "1", " kHz")
		check("hertz", 2.4e9, nil, "", "2.40", " GHz")
	end)

	it("formats temperatures, including the legacy farenheit id", function()
		check("celsius", 21.5, nil, "", "21.5", " °C")
		check("celsius", -40, nil, "", "-40", " °C")
		check("fahrenheit", 98.6, nil, "", "98.6", " °F")
		check("farenheit", 98.6, nil, "", "98.6", " °F")
	end)

	-- The sign moves in front of the symbol: -$1.50K, never $-1.50K.
	it("formats currencyUSD with the sign before the symbol", function()
		check("currencyUSD", 999, nil, "$", "999", "")
		check("currencyUSD", 1000, nil, "$", "1", "K")
		check("currencyUSD", 1500, nil, "$", "1.50", "K")
		check("currencyUSD", 1.5, nil, "$", "1.50", "")
		check("currencyUSD", -1500, nil, "-$", "1.50", "K")
		check("currencyUSD", -5, nil, "-$", "5", "")
	end)

	it("formats locale with en-US grouping and at most 3 fraction digits", function()
		check("locale", 999, nil, "", "999", "")
		check("locale", 1000, nil, "", "1,000", "")
		check("locale", 1234567.12345, nil, "", "1,234,567.123", "")
		check("locale", 1234.5678, 2, "", "1,234.57", "")
		check("locale", -1234.5, 0, "", "-1,235", "")
		check("locale", 0.0005, nil, "", "0.001", "")
		check("locale", -0.0001, nil, "", "-0", "")
	end)
end)

return nil
